API_ENV=local
API_CORS_ORIGINS=["http://localhost:3000"]

API_AZURE_OPENAI_ENDPOINT=
API_AZURE_OPENAI_DEPLOYMENT=gpt-4.1
API_AZURE_OPENAI_API_KEY=

API_AZURE_SPEECH_KEY=
API_AZURE_SPEECH_REGION=

API_AZURE_STORAGE_CONNECTION_STRING=

API_SARVAM_API_KEY=
API_PUBLIC_BASE_URL=http://localhost:8000

# Azure PostgreSQL (asyncpg driver)
API_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require

API_TWILIO_ENABLED=false
API_TWILIO_ACCOUNT_SID=
API_TWILIO_AUTH_TOKEN=
API_TWILIO_PHONE_NUMBER=
API_TWILIO_DEFAULT_ASSIGNMENT=Worker explains their trade experience, tools, material handling, quality checks, and step-by-step work process over a phone interview.